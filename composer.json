{
	"name" : "rooy/laravel-notification",
	"description" : "微信 template message for Laravel Notification",
	"homepage" : "https://github.com/rooyzhang/laravel-notification",
	"license" : "MIT",
	"type" : "library",
	"authors" : [{
			"name" : "Rooy",
			"email" : "rooyzhang@gmail.com",
			"homepage" : "https://github.com/rooyzhang"
		}
	],
	"require" : {
		"php" : "^8.0",
		"overtrue/laravel-wechat" : "^6.0 | ^7.0",
		"laravel/framework" : "^8.12"
	},
	"require-dev" : {
		"laravel/framework" : "^8.12"
	},
	"keywords" : [
		"wechat",
		"laravel",
		"notification"
	],
	"autoload" : {
		"psr-4" : {
			"Rooy\\LaravelNotification\\" : "src/"
		}
	},
	"extra" : {
		"laravel" : {
			"providers" : [
				"Rooy\\LaravelNotification\\ServiceProvider"
			]
		}
	},
	"minimum-stability" : "dev",
	"prefer-stable" : true
}